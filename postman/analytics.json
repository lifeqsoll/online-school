{
  "info": {
    "name": "Online School — Analytics",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "adminEmail", "value": "admin@online-school.local" },
    { "key": "adminPassword", "value": "ChangeMeAdmin123!" }
  ],
  "item": [
    {
      "name": "Login",
      "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Create topic",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Алгебра\"\n}" },
        "url": "{{baseUrl}}/courses/{{courseId}}/topics"
      }
    },
    {
      "name": "Radar me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/courses/{{courseId}}/analytics/radar/me"
      }
    },
    {
      "name": "Cold lessons",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/courses/{{courseId}}/analytics/cold-lessons"
      }
    },
    {
      "name": "Graph",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/courses/{{courseId}}/analytics/graph"
      }
    }
  ]
}
