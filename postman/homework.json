{
  "info": {
    "name": "Online School — Homework",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "lessonId", "value": "" },
    { "key": "assignmentId", "value": "" },
    { "key": "submissionId", "value": "" },
    { "key": "adminEmail", "value": "admin@online-school.local" },
    { "key": "adminPassword", "value": "ChangeMeAdmin123!" }
  ],
  "item": [
    {
      "name": "Login admin",
      "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Create lesson assignment",
      "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('assignmentId', pm.response.json().id);"] } }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scope\": \"LESSON\",\n  \"lessonId\": \"{{lessonId}}\",\n  \"title\": \"Quiz\",\n  \"maxXp\": 100,\n  \"isPublished\": true,\n  \"questions\": [{\n    \"type\": \"CHOICE\",\n    \"prompt\": \"2+2\",\n    \"points\": 10,\n    \"options\": [{\"id\":\"a\",\"text\":\"4\"},{\"id\":\"b\",\"text\":\"5\"}],\n    \"correctKeys\": [\"a\"]\n  }]\n}"
        },
        "url": "{{baseUrl}}/courses/{{courseId}}/assignments"
      }
    },
    {
      "name": "Create submission",
      "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('submissionId', pm.response.json().id);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/assignments/{{assignmentId}}/submissions"
      }
    },
    {
      "name": "Leaderboard",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/courses/{{courseId}}/leaderboard"
      }
    }
  ]
}
