# Copy to .env and fill secrets. Never commit .env.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Postgres (Docker Compose defaults)
DATABASE_URL=postgresql://online_school:online_school@localhost:5432/online_school?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (min 32 chars recommended)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!

# Crypto: 32-byte keys as base64
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
EMAIL_HMAC_KEY=

# Bootstrap admin (seed)
ADMIN_EMAIL=admin@online-school.local
ADMIN_PASSWORD=ChangeMeAdmin123!

# Password reset: expose token in API response for local cURL (never in prod)
DEV_EXPOSE_RESET_TOKEN=true

# Payments (mock only in Catalog slice)
PAYMENT_PROVIDER=mock
PAYMENT_RETURN_URL=http://localhost:3000/catalog.html

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lessons
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SEC=3600
